  ldap:
    enabled: true
    host: "{{ __docker_stack__vikunja__ldap_host }}"
    port: {{ __docker_stack__vikunja__ldap_port }}
    usetls: {{ __docker_stack__vikunja__ldap_usetls | lower }}

    basedn: "{{ __docker_stack__vikunja__ldap_base_dn }}"
    userfilter: "{{ __docker_stack__vikunja__ldap_user_filter }}"

{% if docker_stack__swarm_mode | bool %}
    binddn:
      file: /run/secrets/ldap_username
    bindpassword:
      file: /run/secrets/ldap_password
{% else %}
    binddn: {{ __docker_stack__vikunja__ldap_bind_user_dn }}
    bindpassword: {{ __docker_stack__vikunja__ldap_bind_user_password }}
{% endif %}

    attribute:
      id: "uid"
      username: "uid"
      mail: "mail"
      name: "cn"

    # Optional: group mapping
    group:
      enabled: true
      base: "{{ __docker_stack__vikunja__ldap_groups_dn }}"
#      filter: "(objectClass=*)"
#      filter: "(objectClass=groupOfURLS)"
      filter: "(|(objectClass=group)(objectClass=posixGroup)(objectClass=groupOfNames)(objectClass=groupOfURLs))"
      attribute: "member"
#      attribute: "cn"

{% if __docker_stack__vikunja__ldap_group_sync_enabled | bool %}
    # Group sync filter - accept multiple group objectClasses
    groupsyncenabled: true
    groupsyncfilter: "(|(objectClass=group)(objectClass=posixGroup)(objectClass=groupOfNames)(objectClass=groupOfURLs))"
{% endif %}
