{{ 'Ansible managed' | comment(format="# {}") }}

service:
  frontendurl: "{{ __docker_stack__vikunja__root_url }}"
  publicurl: "{{ __docker_stack__vikunja__root_url }}"
  enableRegistration: true
  enableTaskComments: true
  enableEmailReminders: false

database:
  type: postgres
  host: vikunja-db
  port: 5432
  user: vikunja
{% if docker_stack__swarm_mode | bool %}
  password:
    file: /run/secrets/vikunja_db_password
{% else %}
  password: "{{ __docker_stack__vikunja__db_password }}"
{% endif %}
  database: vikunja
  sslmode: disable

files:
  basepath: /app/vikunja/files

ratelimit:
  enabled: true
  maxrequests: 1000

auth:
  local:
    enabled: true
{% if __docker_stack__vikunja__ldap_enabled | bool %}
{% include 'vikunja/config-ldap.yml.j2' %}
{% endif %}
