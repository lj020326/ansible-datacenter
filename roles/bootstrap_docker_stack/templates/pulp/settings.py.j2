import os

def _load_secret(secret_name, fallback):
    secret_path = f"/run/secrets/{secret_name}"
    if os.path.exists(secret_path):
        with open(secret_path, "r") as f:
            return f.read().strip()
    return os.environ.get(secret_name, fallback)

# Use the helper for SECRET_KEY
SECRET_KEY = _load_secret(
    'pulp_secret_key',
    'DJANGO_SECRET_KEY'
)

PULP_ADMIN_USERNAME = _load_secret(
    'pulp_admin_username',
    'admin'
)

PULP_ADMIN_PASSWORD = _load_secret(
    'pulp_admin_password',
    ''
)

