{{ 'Ansible managed' | comment(format="# {}") }}

{% if __docker_stack__openwebui__enable_persistent_config | bool %}
ENABLE_PERSISTENT_CONFIG=True
{% else %}
# Force the UI to use your .env values over the database settings
ENABLE_PERSISTENT_CONFIG=False
{% endif %}

WEBUI_URL=http://{{ __docker_stack__openwebui__host_addr }}
WEBUI_SESSION_COOKIE_SECURE=false
WEBUI_AUTH_COOKIE_SECURE=false

# CORS_ALLOW_ORIGIN must be a semicolon-separated list
# Include the FQDN, the IP, and localhost
CORS_ALLOW_ORIGIN={{ __docker_stack__openwebui__cors_allow_origin }}

{% if __docker_stack__openwebui__ollama_api_base_url %}
OLLAMA_BASE_URL= {{ __docker_stack__openwebui__ollama_api_base_url }}
{% endif %}
{% if __docker_stack__openwebui__ollama_api_key %}
OLLAMA_API_KEY={{ __docker_stack__openwebui__ollama_api_key }}
{% endif %}

{% if __docker_stack__openwebui__openai_api_base_url %}
# Connect to the specified url as an OpenAI-compatible provider
OPENAI_API_BASE_URLS={{ __docker_stack__openwebui__openai_api_base_url }}
{% endif %}
{% if __docker_stack__openwebui__openai_api_key %}
OPENAI_API_KEY={{ __docker_stack__openwebui__openai_api_key }}
{% endif %}

# ==========================================
# RAG & Code Introspection Configuration
# ==========================================
RAG_TEXT_SPLITTER=token
CHUNK_SIZE={{ __docker_stack__openwebui__rag_chunk_size }}
CHUNK_OVERLAP={{ __docker_stack__openwebui__rag_chunk_overlap }}
ENABLE_RAG_HYBRID_SEARCH={{ __docker_stack__openwebui__enable_rag_hybrid_search }}
RAG_TOP_K={{ __docker_stack__openwebui__rag_top_k }}
RAG_RETRIEVAL={{ __docker_stack__openwebui__rag_retrieval }}
RAG_FULL_CONTEXT_MODE={{ __docker_stack__openwebui__rag_full_context_mode }}

# ==========================================
# vaulted credentials
{% if docker_stack__swarm_mode | bool %}
WEBUI_SECRET_KEY=dksec://openwebui_secret_key
{% else %}
WEBUI_SECRET_KEY={{ __docker_stack__openwebui__secret_key }}
{% endif %}

# ==========================================
# openwebui-init
OPENWEBUI_ADMIN_URL=http://openwebui:8080
{% if docker_stack__swarm_mode | bool %}
OPENWEBUI_ADMIN_API_KEY=dksec://openwebui_secret_key
{% else %}
OPENWEBUI_ADMIN_API_KEY={{ __docker_stack__openwebui__secret_key }}
{% endif %}
