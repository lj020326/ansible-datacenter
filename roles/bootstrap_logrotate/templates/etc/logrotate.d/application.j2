{{ 'Ansible managed' | comment(format="# {}") }}

{% for definition in item.definitions %}
{{ definition.logs | join(" ") }} {
{% for option in definition.options %}
    {{ option }}
{% endfor %}
{% if definition.postrotate | d([], true) %}
    postrotate
{% for line in definition.postrotate %}
        {{ line }}
{% endfor %}
    endscript
{% endif %}
{% if definition.preremove | d([], true) %}
    preremove
{% for line in definition.preremove %}
        {{ line }}
{% endfor %}
    endscript
{% endif %}
{% if definition.lastaction | d([], true) %}
    lastaction
{% for line in definition.lastaction %}
        {{ line }}
{% endfor %}
    endscript
{% endif %}
{% if definition.firstaction | d([], true) %}
    firstaction
{% for line in definition.firstaction %}
        {{ line }}
{% endfor %}
    endscript
{% endif %}
}
{% endfor %}
