# EditorConfig is awesome: https://EditorConfig.org

# Top-most EditorConfig file
root = true

# Global settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Shell Scripts (Bash / POSIX)
# Google Shell Style Guide (2 spaces)
[*.{sh,bash,zsh}]
indent_style = space
indent_size = 4

# Infrastructure as Code & Configuration Files
# Strict requirement for YAML (JSON schema compliance)
[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 2

# Python (PEP 8 compliance)
[*.py]
indent_style = space
indent_size = 4

# Web / UI / Markdown
[*.{js,ts,jsx,tsx,html,css,scss}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
indent_style = space
indent_size = 2

# Go Language (Standard Go toolchain mandates hard tabs)
[*.go]
indent_style = tab
tab_width = 4

# Makefiles (Mandatory hard tabs for rules)
[Makefile, *.mk]
indent_style = tab

# Windows Batch Scripts
[*.{bat,cmd}]
end_of_line = crlf
indent_style = space
indent_size = 4
